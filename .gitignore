# ==============================================================================
# .gitignore — R / Bioconductor packages
# Place a copy of this file in the root of each package repo
# (BiocAI, BiocPrompt, BiocAgent, …)
# ==============================================================================

# Source tarballs produced by R CMD build
*.tar.gz

# R CMD check output directories
*Rcheck/

# R CMD INSTALL staging
*.Rinstignore

# Compiled code (src/)
*.o
*.so
*.dll
*.a
src/*.o
src/*.so
src/*.dll
src/Makevars.win     # generated on Windows; commit Makevars only
src/symbols.rds

# Auto-generated Rd files (roxygen2-managed)
man/*.Rd.bak

# Auto-generated documentation index
.Rd2pdf*
*.pdf

# devtools metadata cache
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# roxygen2 cache
.cache/

docs/
_site/

# covr/codecov artefacts
*.gcov
*.gcno
*.gcda
coverage/
covrpage.md

# BiocCheck output
*BiocCheck*/

# BiocStyle cache
*-concordance.tex
*.synctex.gz

# Vignette build artefacts (keep *.Rmd / *.Rnw; ignore rendered outputs)
vignettes/*.html
vignettes/*.pdf
vignettes/*.R           # tangled R scripts
vignettes/*_cache/
vignettes/*_files/
vignettes/.cache/
inst/doc/*.html
inst/doc/*.pdf
inst/doc/*.R
inst/doc/*_cache/


# RStudio / IDE
*.Rproj
.Rproj.user/
.Rhistory
.RData

# Make / CI logs (generated by the BiocAI Makefile)
.make-logs/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.nfs*

# renv lockfile cache (commit renv.lock itself; ignore the cache)
renv/library/
renv/staging/
renv/python/
.renv/

# pak cache
.pkg/

# Python (if any reticulate use)
__pycache__/
*.py[cod]
.venv/
.python-version

# Node (if any JS tooling)
node_modules/

# Credentials / secrets — never commit these
.env
.env.*
*.pem
*.key

# Personal files
NOTES.md
